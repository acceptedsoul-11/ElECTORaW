
# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=electoraw
MYSQL_USER=replace_with_local_db_user
MYSQL_PASSWORD=replace_with_local_db_password
WORKFLOW_BACKEND=mysql

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DATABASE=electoraw

# Application
APP_ENV=development
APP_SECRET_KEY=replace_with_a_random_secret

# ELECTORaW runtime
ELECTORAW_DATA_BACKEND=mysql
ELECTORAW_DATA_ROOT=./data/processed
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_TOKEN=replace_with_a_long_random_admin_token

# Legacy migration source and local generated artifacts
WORKFLOW_DB_PATH=./database/electoraw_workflow.sqlite3
CERTIFICATE_DIR=./database/certificates
VECTOR_DB_PATH=./database/chroma
VECTOR_COLLECTION=electoraw_corpus

# Optional OpenAI-compatible generation provider. The default local agent uses
# deterministic structured answers plus TF-IDF retrieval and needs no key.
RAG_LLM_BASE_URL=
RAG_LLM_API_KEY=
RAG_LLM_MODEL=
